# Copie a .env y ajuste. Nunca suba .env al repositorio.
APP_PROVIDER=ollama
APP_OLLAMA_BASE_URL=http://127.0.0.1:11434
APP_MODEL=qwen2.5:1.5b
APP_MAX_OUTPUT_TOKENS=512
APP_TEMPERATURE=0.2
APP_LOG_LEVEL=INFO

# Demo 2 · mismo backend contra un endpoint compatible con OpenAI.
# Ejemplo con el endpoint /v1 de Ollama (no requiere clave):
# APP_PROVIDER=openai_compat
# APP_OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# APP_OPENAI_API_KEY=

# OpenTelemetry (opcional). "console" imprime los spans; "otlp" los envía a un colector.
APP_OTEL_ENABLED=false
APP_OTEL_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
