# Copie a .env (excluido de git). Autenticación: `az login`, sin claves de API.
# Endpoint del proyecto de Microsoft Foundry (página de información del proyecto)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# Nombre del despliegue del modelo. En trial use un modelo del Tier 0 (p. ej., gpt-5-mini)
FOUNDRY_MODEL_DEPLOYMENT=gpt-5-mini
# Endpoint compatible con Azure OpenAI del mismo recurso (para SK, AutoGen y LangGraph)
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
# Verifique la versión de API vigente compatible con su modelo en la documentación
AZURE_OPENAI_API_VERSION=2024-10-21
