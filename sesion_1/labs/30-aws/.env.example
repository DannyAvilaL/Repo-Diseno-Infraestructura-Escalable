# Copie a .env (excluido de git). Autenticación: perfil SSO (aws configure sso), sin claves en archivos.
AWS_PROFILE=llm-curso
AWS_REGION=us-east-1
# Identificador del modelo o perfil de inferencia disponible en su región (consola de Bedrock).
# Ejemplo a verificar: us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
