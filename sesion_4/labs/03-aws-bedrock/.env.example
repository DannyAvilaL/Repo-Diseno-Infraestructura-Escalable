# Copie a .env (no versionar). Credenciales: aws sso login / rol IAM; sin claves en el archivo.
AWS_REGION=us-east-1
# ID o perfil de inferencia de un modelo HABILITADO en su cuenta (consola Bedrock > Model catalog; o
# `aws bedrock list-inference-profiles --region $AWS_REGION`). Los IDs cambian con el tiempo: no copie de internet.
BEDROCK_MODEL_ID=
# Solo para invoke_console_agent.py (Parte A)
BEDROCK_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=
