# Copie a .env (no versionar). Autenticación: `az login` (Entra ID). Sin claves de API.
AZURE_AI_PROJECT_ENDPOINT=https://<cuenta>.services.ai.azure.com/api/projects/<proyecto>
AZURE_OPENAI_ENDPOINT=https://<cuenta>.openai.azure.com/
# NOMBRE del despliegue creado en Foundry (no el nombre del modelo base)
AZURE_AI_MODEL_DEPLOYMENT=<nombre-del-despliegue>
AZURE_OPENAI_API_VERSION=2024-10-21
