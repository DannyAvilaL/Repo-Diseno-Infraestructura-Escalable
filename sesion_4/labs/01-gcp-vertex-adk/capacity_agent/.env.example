# Copie a capacity_agent/.env (no lo suba a git). Autenticación: ADC (gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Algunos modelos recientes solo están en 'global' (verifique la tabla de ubicaciones del modelo elegido)
GOOGLE_CLOUD_LOCATION=global
# Verifique el ID vigente en Model Garden / documentación; los modelos 2.5 se retiraron en Vertex AI en oct-2026
GEMINI_MODEL=gemini-3.8-flash
