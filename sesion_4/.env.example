# Copie a .env (NO lo suba a git). Prefijo GW_ = LLM Gateway.
GW_OLLAMA_BASE_URL=http://localhost:11434
GW_MODEL=llama3.2:1b
# Debe coincidir con OLLAMA_NUM_PARALLEL del servidor de inferencia
GW_MAX_CONCURRENCY=2
GW_MAX_QUEUE=20
GW_QUEUE_TIMEOUT_S=30
GW_REQUEST_TIMEOUT_S=120
# Genere una clave: python -c "import secrets;print(secrets.token_urlsafe(32))"
# GW_API_KEY=
GW_LOG_LEVEL=INFO
