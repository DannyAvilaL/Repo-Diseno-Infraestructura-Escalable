# Copie a .env y ajuste. Nunca suba .env al repositorio.

# --- Regiones -----------------------------------------------------------------
# Lista JSON. Las claves de API NO van aquí: use api_key_env con el NOMBRE de la
# variable que contiene la clave (defínala aparte, fuera del repositorio).
#
# Opción 1 (predeterminada): dos regiones simuladas (scripts/mock_region.py).
APP_REGIONS=[{"name":"region-a","base_url":"http://127.0.0.1:9001/v1","model":"simulado","priority":1,"sim_admin_url":"http://127.0.0.1:9001/admin/state"},{"name":"region-b","base_url":"http://127.0.0.1:9002/v1","model":"simulado","priority":2,"sim_admin_url":"http://127.0.0.1:9002/admin/state"}]
#
# Opción 2 (híbrida): Ollama local como primaria y una región simulada como respaldo.
# APP_REGIONS=[{"name":"local-ollama","base_url":"http://127.0.0.1:11434/v1","model":"qwen2.5:1.5b","priority":1},{"name":"region-b","base_url":"http://127.0.0.1:9002/v1","model":"simulado","priority":2,"sim_admin_url":"http://127.0.0.1:9002/admin/state"}]
#
# Opción 3 (nube): dos recursos de Microsoft Foundry en regiones distintas (endpoint /openai/v1).
# El modelo es el NOMBRE DEL DESPLIEGUE. /models lista modelos base, por eso check_model=false.
# APP_REGIONS=[{"name":"eastus2","base_url":"https://<recurso-1>.openai.azure.com/openai/v1","model":"gpt-5-mini","priority":1,"api_key_env":"AZURE_KEY_EASTUS2","auth_header":"api-key","check_model":false},{"name":"swedencentral","base_url":"https://<recurso-2>.openai.azure.com/openai/v1","model":"gpt-5-mini","priority":2,"api_key_env":"AZURE_KEY_SWEDEN","auth_header":"api-key","check_model":false}]
# Nota: los modelos de razonamiento pueden rechazar "max_tokens" o "temperature";
# para la opción 3 use un modelo que los admita o el laboratorio AZ-G (SDK oficial).

# "priority" = activo-pasivo · "round_robin" = activo-activo
APP_ROUTING=priority

# --- Tiempos y resiliencia ------------------------------------------------------
APP_CONNECT_TIMEOUT_S=2
APP_FIRST_BYTE_TIMEOUT_S=15
APP_MAX_ATTEMPTS=3
APP_CB_FAILURE_THRESHOLD=3
APP_CB_FAILURE_WINDOW_S=30
APP_CB_OPEN_S=15
APP_HEALTH_INTERVAL_S=5

# --- Lotes ----------------------------------------------------------------------
# Relativo a backend/, donde se inicia uvicorn: los resultados quedan en labs/01-local-gateway/data/
APP_BATCH_DIR=../data/batches
APP_BATCH_CONCURRENCY=2
APP_BATCH_YIELD_ONLINE_INFLIGHT=2
APP_BATCH_MAX_REQUESTS=5000
# 86400 = 24 h, como los servicios gestionados. Bájelo (p. ej., 30) para demostrar "expired".
APP_BATCH_COMPLETION_WINDOW_S=86400

# --- Seguridad y observabilidad -------------------------------------------------
# Si se define, /admin/* exige la cabecera X-Admin-Token. Genere un valor aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# APP_ADMIN_TOKEN=
APP_MAX_OUTPUT_TOKENS=512
APP_LOG_LEVEL=INFO
APP_OTEL_ENABLED=false
APP_OTEL_EXPORTER=console
