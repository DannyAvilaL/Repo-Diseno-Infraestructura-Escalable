{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3LoteDelCurso",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/pqrs/*"],
      "Condition": { "StringEquals": { "aws:ResourceAccount": ["<ACCOUNT_ID>"] } }
    }
  ]
}
