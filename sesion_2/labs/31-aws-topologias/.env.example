# Copie a .env (excluido de git). Autenticación: perfil de AWS CLI (aws configure sso
# o credenciales temporales). Nunca escriba claves de acceso en este archivo.

# --- Online multi-región (AWS-E.2 a AWS-E.4) --------------------------------------
# Destinos en orden de prioridad. model_id puede ser un modelo de una región o un
# perfil de inferencia entre regiones (prefijo us., eu., global.). Verifique en la
# consola de Bedrock qué identificadores están disponibles en cada región.
AWS_TARGETS=[{"region":"us-east-1","model_id":"amazon.nova-lite-v1:0"},{"region":"us-west-2","model_id":"us.amazon.nova-lite-v1:0"}]

# --- Batch (AWS-E.5 y AWS-E.6) -------------------------------------------------------
AWS_BATCH_REGION=us-east-1
AWS_BATCH_BUCKET=llm-curso-<usuario>-batch
# Nova Lite admite batch en una sola región en us-east-1 (tabla oficial, 20-oct-2026).
AWS_BATCH_MODEL_ID=amazon.nova-lite-v1:0
# Lo imprime iam/crear_rol.sh
AWS_BATCH_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/bedrock-batch-pqrs
