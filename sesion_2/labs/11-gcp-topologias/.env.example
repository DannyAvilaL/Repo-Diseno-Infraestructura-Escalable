# Copie a .env (excluido de git). Autenticación: gcloud auth application-default login
# Use la plataforma (Gemini Enterprise Agent Platform), no una clave de AI Studio:
# el crédito de la prueba gratuita no cubre la Gemini API de AI Studio.
GOOGLE_CLOUD_PROJECT=llm-curso-<usuario>

# Modelo vigente de Model Garden. Las notas de versión registran la disponibilidad
# general de Gemini 3.8 Flash el 2-sep-2026; Gemini 2.5 tiene retiro anunciado.
# Verifique el identificador exacto y que el modelo admita batch en su región.
GEMINI_MODEL=gemini-3.8-flash

# Online: ubicaciones en orden de prioridad. "global" mejora la disponibilidad pero
# no garantiza residencia de datos.
GCP_LOCATIONS=["us-central1", "global"]

# Batch: bucket de Cloud Storage en la misma región del trabajo.
GCP_BATCH_LOCATION=us-central1
GCP_BATCH_BUCKET=llm-curso-<usuario>-batch
