# Copie a .env (excluido de git). Autenticación: `az login` (Microsoft Entra ID), sin claves.

# --- Online multi-región (AZ-G.1 a AZ-G.5) ---------------------------------------
# Dos recursos de Microsoft Foundry en regiones distintas, en orden de prioridad.
# "deployment" es el NOMBRE DEL DESPLIEGUE (no el nombre del modelo).
AZ_REGIONS=[{"name":"eastus2","endpoint":"https://<recurso-eastus2>.openai.azure.com","deployment":"gpt-5-mini"},{"name":"swedencentral","endpoint":"https://<recurso-sweden>.openai.azure.com","deployment":"gpt-5-mini"}]

# --- Batch (AZ-G.6, requiere suscripción de pago) --------------------------------
# Recurso con un despliegue de tipo Global Batch (o Data Zone Batch).
AZ_BATCH_ENDPOINT=https://<recurso>.openai.azure.com
AZ_BATCH_DEPLOYMENT=gpt-4.1-mini-batch
