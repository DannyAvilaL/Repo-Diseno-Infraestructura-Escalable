# Copie a .env en esta carpeta. Autenticación: gcloud auth application-default login
# Usar la plataforma (Vertex) y NO una clave de AI Studio: el crédito trial no cubre AI Studio.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=llm-curso-<usuario>
GOOGLE_CLOUD_LOCATION=us-central1
# Elija un modelo Gemini disponible en su región (Model Garden). Verifique el nombre vigente.
# Actualización 20-oct-2026: Google anunció el retiro de Gemini 2.5 en la plataforma
# (no antes del 16-oct-2026). Las notas de versión registran Gemini 3.8 Flash como GA.
GEMINI_MODEL=gemini-3.8-flash
