# Copiar a .env y ajustar. NUNCA subir .env al repositorio.
SLLM_ENV=local                      # local | dev | prod
SLLM_PROVIDER=mock                  # mock | ollama
SLLM_OLLAMA_BASE_URL=http://localhost:11434
SLLM_OLLAMA_MODEL=llama3.2:1b
SLLM_OLLAMA_KEEP_ALIVE=5m
SLLM_EAGER_INIT=false               # true = precarga en arranque (mitiga cold start de primera peticion)
SLLM_API_KEYS=dev-key-change-me:tenant-a,other-key:tenant-b
SLLM_INJECTION_POLICY=flag          # off | flag | block
SLLM_RATE_LIMIT_PER_MINUTE=120
SLLM_MAX_CONCURRENCY=4
